EXPO_PUBLIC_RUNTIME_URL=http://localhost:3100/api/mobile-copilotkit

# TTS flag: "robotic" (default, free, on-device expo-speech) or "realistic"
# (cloud voice via /api/tts, small per-character cost). See packages/tts/README.md.
# EXPO_PUBLIC_TTS_MODE=realistic

# Face-presence flag: off by default. When "true", mounts a camera that polls
# a cloud vision call to notice someone's there and start listening
# automatically. Costs a small amount per check — see packages/presence/README.md
# before turning this on.
# EXPO_PUBLIC_ENABLE_FACE_PRESENCE=true
